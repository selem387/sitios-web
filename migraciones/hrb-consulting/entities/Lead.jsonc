{
  "name": "Lead",
  "description": "Prospecto de contacto generado desde los formularios del sitio (ficha de propiedad o secci\u00f3n de contacto).",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre completo"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono o WhatsApp"
    },
    "message": {
      "type": "string",
      "description": "Mensaje o inter\u00e9s del prospecto"
    },
    "property_id": {
      "type": "string",
      "description": "ID de la propiedad de inter\u00e9s"
    },
    "property_title": {
      "type": "string",
      "description": "T\u00edtulo de la propiedad de inter\u00e9s"
    },
    "status": {
      "type": "string",
      "enum": [
        "nuevo",
        "contactado",
        "calificado",
        "cerrado",
        "descartado"
      ],
      "default": "nuevo"
    },
    "source": {
      "type": "string",
      "default": "web",
      "description": "Origen del lead: ficha, contacto, etc."
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}