{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "760px", "wideSize": "1200px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base", "name": "Fondo", "color": "#FBFAF7" },
        { "slug": "surface", "name": "Superficie", "color": "#F1EEE7" },
        { "slug": "contrast", "name": "Texto", "color": "#1B2420" },
        { "slug": "muted", "name": "Texto suave", "color": "#5B6660" },
        { "slug": "primary", "name": "Principal", "color": "#1F4D43" },
        { "slug": "accent", "name": "Acento", "color": "#C8893E" },
        { "slug": "white", "name": "Blanco", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        { "slug": "heading", "name": "Títulos", "fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif" },
        { "slug": "body", "name": "Texto", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Chica", "size": "0.875rem" },
        { "slug": "medium", "name": "Normal", "size": "1.0625rem" },
        { "slug": "large", "name": "Grande", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
        { "slug": "x-large", "name": "Muy grande", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
        { "slug": "xx-large", "name": "Portada", "size": "3.5rem", "fluid": { "min": "2.4rem", "max": "3.5rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "1", "size": "0.5rem" },
        { "slug": "30", "name": "2", "size": "1rem" },
        { "slug": "40", "name": "3", "size": "1.5rem" },
        { "slug": "50", "name": "4", "size": "clamp(2rem, 4vw, 3rem)" },
        { "slug": "60", "name": "5", "size": "clamp(3rem, 7vw, 5.5rem)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65" },
    "spacing": { "padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" }, "blockGap": "1.25rem" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "lineHeight": "1.15", "letterSpacing": "-0.01em" }, "color": { "text": "var(--wp--preset--color--contrast)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } } },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--white)" },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.5rem", "right": "1.5rem" } },
        "typography": { "fontWeight": "600" },
        ":hover": { "color": { "background": "var(--wp--preset--color--accent)" } }
      }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" } },
      "core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "700" } },
      "core/image": { "border": { "radius": "14px" } },
      "core/cover": { "border": { "radius": "0" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Encabezado", "area": "header" },
    { "name": "footer", "title": "Pie de página", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-sin-titulo", "title": "Página sin título (para landings)", "postTypes": ["page"] }
  ]
}
